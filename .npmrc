# .npmrc for AI Remote Engineering OS — ADR-0042.
# Offline-install posture per ADR-0001 and the Offline-Install Engineer
# charter (ai/roles/specialists/offline-install-engineer.md).

# Pinned registry — ADR-0042 §Decision.
registry=https://registry.npmjs.org/

# Restricted-network compatibility — ADR-0042 §Decision named both:
package-import-method=hardlink
prefer-offline=true

# Predictability for offline + restricted-network installs.
# `isolated` keeps the pnpm content-addressed store benefits and avoids
# the flat node_modules layout that re-introduces npm-style hoisting.
node-linker=isolated
strict-peer-dependencies=true
auto-install-peers=false

# CI / reproducibility. Lockfile is generated by the first frontend
# ticket; until then `pnpm install` is a no-op against zero members.
frozen-lockfile=true
engine-strict=true
