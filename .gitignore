# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Staging
/_v3_*.md

# Release binaries live in sibling ../artifacts/, never in this repo.
# (No rules needed here — kept for documentation.)

# Go (ADR-0041 / ADR-0042)
/bin/
*.exe
*.test
*.test.exe
*.out

# Node / pnpm (ADR-0042 / ADR-0047)
node_modules/
.pnpm-store/
dist/
.vite/

# Task (ADR-0042)
.task/

# WD-10 e2e scratch context-source roots (T-101): real temp directories the live
# harness registers as context sources over the shared /work bind mount so both the
# tester and api containers see the same files; removed in t.Cleanup, ignored here
# as a second line of defense against a failed run leaving litter.
tests/e2e/.wd10-scratch/

# Env files
.env
.env.local
**/.env
!**/env.example

# Go build outputs that land in the tree when a containerised build writes into
# the bind-mounted repo (Linux ELF binaries on a Windows host). They are build
# artifacts, never sources — ignore them so `git status` stays a real signal.
/seed
/tests/e2e/seed
/tools/migrate-lint/migrate-lint
/tools/forbidden-features-check/forbidden-features-check
