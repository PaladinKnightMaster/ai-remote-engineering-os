# systemd unit template — services/api (§OI-a, ADR-0051).
# install.sh (§OI-b) installs binaries to /opt/aireos/bin, the shared env file to
# /etc/aireos/aireos.env (DATABASE_URL, AIREOS_PASETO_KEY, AIREOS_BOOTSTRAP_OPERATOR_*,
# service addrs/URLs), and enables this unit. AIREOS_RESOURCE_SECRET_KEY is NOT in
# aireos.env — it lives solely in /etc/aireos/connector.env, read only by
# aireos-connector.service (SEC-13/OI-6: api holds no credential key since v0.2.0).
[Unit]
Description=AI ReOS — API control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aireos
Group=aireos
EnvironmentFile=/etc/aireos/aireos.env
# api signs agent-tool tokens on the asymmetric agent plane (ADR-0060); its private
# key lives ONLY in api.env (least-privilege, like connector.env), not in shared
# aireos.env. A missing api.env leaves AIREOS_API_AGENT_SIGN_KEY unset → api falls
# back to symmetric agent-token mint (the gateway then expects symmetric — keep them
# in lockstep via install.sh).
EnvironmentFile=/etc/aireos/api.env
ExecStart=/opt/aireos/bin/api serve
Restart=on-failure
RestartSec=2
# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
