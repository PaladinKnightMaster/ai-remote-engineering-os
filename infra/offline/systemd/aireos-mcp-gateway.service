# systemd unit template — services/mcp-gateway (§OI-10, ADR-0056/0057; T-043a).
# The Typed MCP Gateway (the first agent surface): agents present an agent-tool
# Bearer to the /mcp endpoint; the gateway opens a governed invocation (policy →
# operator approval → connector lease → broker exec → audit). It reads its real
# capability verifier key + downstream URLs from aireos.env — it must NEVER run with
# the MCP_GATEWAY_DEV_INSECURE_AUTH dev flag (R6: that is an allow-all dev verifier).
# Holds no resource-secret key (SEC-13/17).
[Unit]
Description=AI ReOS — mcp-gateway (Typed MCP Gateway, the agent surface)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aireos
Group=aireos
EnvironmentFile=/etc/aireos/aireos.env
ExecStart=/opt/aireos/bin/mcp-gateway serve
Restart=on-failure
RestartSec=2
# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
