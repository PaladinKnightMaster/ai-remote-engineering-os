# systemd unit template — services/audit-service (§OI-a, ADR-0051).
# The append-only chained-hash chain authority (ADR-0045).
[Unit]
Description=AI ReOS — audit-service (chain authority)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aireos
Group=aireos
EnvironmentFile=/etc/aireos/aireos.env
EnvironmentFile=/etc/aireos/audit.env
ExecStart=/opt/aireos/bin/audit-service serve
Restart=on-failure
RestartSec=2
# Hardening. ProtectSystem=strict makes the FS read-only except the anchor dir
# (ADR-0069 D4/T-125a; T-125b's writer needs $STATE/audit to be writable).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aireos

[Install]
WantedBy=multi-user.target
