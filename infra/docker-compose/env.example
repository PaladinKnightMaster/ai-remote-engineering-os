# Reference env for infra/docker-compose/docker-compose.mvp.yml (T-002).
# Postgres only at P0. Per-service vars land with each service ticket.
# The MVP compose hard-codes the values below for local dev; this file
# exists so operators have a single place to override them.

POSTGRES_DB=cockpit
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=change-me

# POLICY_URL (services/api, OI-38 / ADR-0074 §D2) — MANDATORY when running
# services/api "serve": it consults the policy decision point on every
# session-start, not only requires_approval-labeled resources (CON-6), and
# refuses to start without it. Not exercised by docker-compose.mvp.yml (postgres
# only); set by docker-compose.e2e.yml (and inherited by smoke/review) and by the
# offline installer. Example: POLICY_URL=http://127.0.0.1:8084
