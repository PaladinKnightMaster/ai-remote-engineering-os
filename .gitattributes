# Line-ending normalization.
#
# Source is stored with LF in the repo and checked out with LF on every
# platform, so Windows core.autocrlf does not rewrite files to CRLF (which is
# what produced the "LF will be replaced by CRLF" warnings). Go tooling, SQL,
# and shell here-strings all expect LF.
* text=auto eol=lf

# Be explicit for the file types this repo actually contains.
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf

# Binary release/asset types (none tracked today; future-proofing so git never
# tries to normalize or diff them as text).
*.png   binary
*.pdf   binary
*.zip   binary
*.xlsx  binary
