{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserCommand",
  "type": "object",
  "required": [
    "id",
    "sessionId",
    "command"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "command": {
      "enum": [
        "open",
        "snap",
        "click",
        "type",
        "wait",
        "logs",
        "screenshot",
        "audit",
        "close"
      ]
    },
    "args": {
      "type": "object"
    }
  }
}