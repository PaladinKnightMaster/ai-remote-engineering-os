{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainPack",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}