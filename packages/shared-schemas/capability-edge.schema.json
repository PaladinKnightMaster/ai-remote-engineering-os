{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityEdge",
  "type": "object",
  "required": [
    "id",
    "sourceRef",
    "targetRef",
    "capabilities",
    "policyId"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "sourceRef": {
      "type": "string"
    },
    "targetRef": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policyId": {
      "type": "string"
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
