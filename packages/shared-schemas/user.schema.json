{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/user.schema.json",
  "title": "User",
  "type": "object",
  "required": [
    "id",
    "email",
    "organizationId",
    "authMode"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "organizationId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "authMode": {
      "type": "string",
      "enum": [
        "local",
        "external_idp"
      ]
    },
    "role": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
